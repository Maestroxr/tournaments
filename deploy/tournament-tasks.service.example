[Unit]
Description=Run backgammon tournament background tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Bot1 values verified against both existing tournament job units.
# Adapt User, Group and EnvironmentFile when installing on another host.
User=administrator
WorkingDirectory=/home/dev/backgammon-tournaments-backend/tournaments
EnvironmentFile=/home/dev/backgammon-tournaments-backend/.env
ExecStart=/home/dev/backgammon-tournaments-backend/venv/bin/python -u manage.py run_tasks
# A batch can take longer while the game server is unavailable.
TimeoutStartSec=0
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
