# Local GameLink configuration for the tournaments backend.
# Copy this file to `.env`, generate two distinct secrets, and keep `.env` private.
GAMELINK_ENABLED=0
GAMELINK_BACKGAMMON_URL=http://127.0.0.1:8000
GAMELINK_TICKET_SECRET=
GAMELINK_RESULT_SECRETS=
GAMELINK_COMMAND_SECRET=
CSRF_TRUSTED_ORIGINS=https://your-admin-domain.example

# Sandbox membership plans: set only IDs verified in your sandbox account.
# Each configured paid tier needs a distinct ID. Empty tiers cannot be purchased.
PAYPAL_GOLD_PLAN_ID=
PAYPAL_PREMIUM_PLAN_ID=
PAYPAL_VIP_PLAN_ID=
# Optional default for clients without a tier selector; must match an ID above.
PAYPAL_PLAN_ID=

# Optional phone Web Push. Private key: server-only PEM file path or base64 DER.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
GOOGLE_CLIENT_ID=

# Tranzila: no charges or automatic entitlement grants are enabled by this setup.
# Obtain a merchant TEST terminal before setting ENABLED=1. Test is a label,
# not a different provider host. Store credentials on the server only.
TRANZILA_ENABLED=0
TRANZILA_ENVIRONMENT=test
TRANZILA_TERMINAL=
TRANZILA_APP_KEY=
TRANZILA_APP_SECRET=
TRANZILA_RETURN_URL=
TRANZILA_NOTIFY_URL=
# Confirm terminal slot 1=checkout_id, slot 20=DCdisable and verified debit
# report semantics with the provider before enabling checkout sessions.
TRANZILA_REPORT_MAPPING_CONFIRMED=0
# Exact active/non-cancelled report transtatus value confirmed by Tranzila.
# Deliberately no default: documentation does not establish its semantics.
TRANZILA_APPROVED_TRANSTATUS=
